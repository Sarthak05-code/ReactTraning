---
// src/pages/index.astro
import BaseLayout from "../layouts/BaseLayout.astro";

const title = "My First Astro App";
const message = "Astro + Tailwind CSS is working!";
---

<BaseLayout title={title} description="Welcome to my homepage!">
    <main class="flex min-h-screen flex-col items-center justify-center gap-4">
        <h1 class="text-5xl font-bold text-cyan-400">{title}</h1>

        <p class="text-xl text-slate-300">{message}</p>

        <button class="rounded-lg bg-cyan-500 px-6 py-3 font-semibold text-white transition hover:bg-cyan-600">
            Click Me
        </button>
    </main>
</BaseLayout>
